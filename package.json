{
  "name": "qa-github-portfolio",
  "version": "1.0.0",
  "description": "End-to-end UI and API automation framework using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "docker:build": "docker compose build",
    "docker:test": "docker compose run --rm playwright",
    "docker:smoke": "docker compose run --rm playwright npx playwright test --grep @smoke"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "api-testing",
    "e2e-testing"
  ],
  "author": "Rajat Patil",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  }
}
